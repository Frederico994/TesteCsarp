@page
@model ListadragonballModel
@{
    ViewData["Title"] = "Dragon Ball";
}

<p>Lista de personagens </p>

@if (Model.ListadragonballModel?.Count > 0)
{
    <div style="display: flex; flex-wrap: wrap;">
        @foreach (var Listadragonball in Model.ListadragonballModel)
        {
            <div style="border: 1px solid #ccc; margin: 10px; padding: 10px; width: 200px;">
                <img src="@Listadragonball.image" alt="Personagem de @Listadragonball.OfficialName" width="100" />
                <p><strong>@Listadragonball.OfficialName</strong></p>
                <p>Código: @Listadragonball.OfficialName</p>
                <p><a asp-page="/Listadragonball" asp-route-cod="@Listadragonball.OfficialName">Id= 1</a></p>
            </div>
        }
    </div>
}
else
{
    <p>ERRO : não temos lista </p>
}
