@page
@model ListadragonballModel
@{
    ViewData["Title"] = "Lista de Personagens de DragonBall";
}

<p>Lista de personagens </p>

@if (Model.Personagens?.Count > 0)
{
    <div style="display: flex; flex-wrap: wrap;">
        @foreach (var Personagem in Model.Personagens)
        {
            <div style="border: 1px solid #ccc; margin: 10px; padding: 10px; width: 200px;">
                <img src="@Personagem.image" alt="Imagem de @Personagem.name" width="100" />
                <p><strong>@Personagem.name</strong></p>
                <p>Código: @Personagem.id</p>
                <p><a asp-page="/InfoDragonBall" asp-route-cod="@Personagem.id">Ver Info</a></p>
            </div>
        }
    </div>
}
else
{
    <p>ERRO : não temos lista </p>
}
