@page
@model TesteCsarp.Pages.InfodragonballModel
@{
    ViewData["Title"] = "Informação do Personagem Dragon Ball";
}

<div class="row mt-4">
    <div class="col-md-6">
        <img src="@Model.Personagem.Image" alt="Imagem de @Model.Personagem.Name" class="img-fluid rounded" />
    </div>
    <div class="col-md-6">
        <h1>@Model.Personagem.Name</h1>
        <p><strong>Afiliação:</strong> @Model.Personagem.Affiliation</p>
        <p><strong>Descrição:</strong></p>
        <p>@Model.Personagem.Description</p>
        <a class="btn btn-secondary" asp-page="/Listadragonball">Voltar à lista</a>
    </div>
</div>
